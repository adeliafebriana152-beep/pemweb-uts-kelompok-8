<%- include('../../partials/header', { pageTitle: pageTitle }) %>
<section class="form-card">
    <h2>Edit Tugas #<%= tugas.id %></h2>
<form action="/event/<%= event.id %>/task/edit/<%= task.id %>" method="POST">
        <div class="form-group">
            <label for="nama_task">Nama Tugas:</label>
            <input type="text" id="nama_task" name="nama_task" value="<%= tugas.nama_task %>" required>
        </div>

        <div class="form-group">
            <label for="divisi">Divisi:</label>
            <select id="divisi" name="divisi" required>
                <option value="">-- Pilih Divisi --</option>
                <% divisiList.forEach(k => { %>
                    <option value="<%= k %>" <%= tugas.kategori === k ? 'selected' : '' %>><%= k %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group">
            <label for="prioritas">Prioritas:</label>
            <select id="prioritas" name="prioritas" required>
                <option value="">-- Pilih Prioritas --</option>
                <option value="tinggi" <%= tugas.prioritas === 'tinggi' ? 'selected' : '' %>>Tinggi</option>
                <option value="sedang" <%= tugas.prioritas === 'sedang' ? 'selected' : '' %>>Sedang</option>
                <option value="rendah" <%= tugas.prioritas === 'rendah' ? 'selected' : '' %>>Rendah</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tgl_deadline">Tanggal Deadline:</label>
            <input type="date" id="tgl_deadline" name="tgl_deadline" value="<%= tugas.tgl_deadline %>" required>
        </div>
        <div class="form-group">
            <label for="status_task">Status Tugas:</label>
            <select id="status_task" name="status_task" required>
                <option value="">-- Pilih Status --</option>
                <option value="belum" <%= tugas.status_task === 'belum' ? 'selected' : '' %>>Belum</option>
                <option value="diproses" <%= tugas.status_task === 'diproses' ? 'selected' : '' %>>Diproses</option>
                <option value="selesai" <%= tugas.status_task === 'selesai' ? 'selected' : '' %>>Selesai</option>
            </select>
        </div>
        <div class="form-group">
            <label for="panitia_id">Penanggung Jawab</label>
            <select name="panitia_id" id="panitia_id">
            <option value="">Belum ditentukan</option>
            <% panitiaList.forEach(p => { %>
            <option value="<%= p.id %>" <%= task.panitia_id == p.id ? 'selected' : '' %>><%= p.nama %></option>
            <% }) %>
            </select>
        </div>
        <button type="submit">Simpan Perubahan</button>
        <a href="/task" class="tombol-batal">Batal</a>
    </form>
</section>
<%- include('../../partials/footer') %>
<%- include('../../partials/header') %>
<%- include('../../partials/nav', { active: 'peserta' }) %>

<h1><%= title %></h1>

<% if (errors.length > 0) { %>
  <div class="alert error"><ul>
    <% errors.forEach(err => { %><li><%= err %></li><% }) %>
  </ul></div>
<% } %>

<form method="POST" action="<%= action %>" class="form">
  <label>Nama</label>
  <input type="text" name="nama" maxlength="100" value="<%= peserta.nama || '' %>" required>

  <label>NIM</label>
  <input type="text" name="nim" maxlength="20" value="<%= peserta.nim || '' %>" required>

  <label>Email</label>
  <input type="email" name="email" maxlength="100" value="<%= peserta.email || '' %>" required>

  <label>No HP</label>
  <input type="text" name="no_hp" maxlength="20" value="<%= peserta.no_hp || '' %>" required>

  <label>Prodi</label>
  <input type="text" name="prodi" maxlength="80" value="<%= peserta.prodi || '' %>" required>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Simpan</button>
    <a href="<%= base %>" class="btn">Batal</a>
  </div>
</form>

<%- include('../../partials/footer') %>
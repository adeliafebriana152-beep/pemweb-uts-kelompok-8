<%- include('../../partials/header') %>
<%- include('../../partials/nav', { active: 'task' }) %>

<div class="top-bar">
  <h1>Tugas Panitia</h1>
  <a href="<%= base %>/create" class="btn btn-primary">+ Tambah Tugas</a>
</div>

<% if (msg === 'created') { %><div class="alert success">Tugas berhasil ditambahkan.</div><% } %>
<% if (msg === 'updated') { %><div class="alert success">Tugas berhasil diperbarui.</div><% } %>
<% if (msg === 'deleted') { %><div class="alert success">Tugas berhasil dihapus.</div><% } %>

<form method="GET" action="<%= base %>" class="filter">
  <select name="divisi">
    <option value="">Semua Divisi</option>
    <% divisiList.forEach(d => { %>
      <option value="<%= d %>" <%= divisiAktif === d ? 'selected' : '' %>><%= d %></option>
    <% }) %>
  </select>
  <select name="status">
    <option value="">Semua Status</option>
    <% STATUS_TASK.forEach(s => { %>
      <option value="<%= s %>" <%= statusAktif === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn">Terapkan</button>
  <a href="<%= base %>" class="btn">Reset</a>
</form>

<% if (tasks.length === 0) { %>
  <div class="empty">Belum ada tugas</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>No</th><th>Nama Tugas</th><th>Divisi</th><th>Prioritas</th><th>Deadline</th><th>Status</th><th>Penanggung Jawab</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% tasks.forEach((t, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= t.nama_task %></td>
            <td><%= t.divisi %></td>
            <td><span class="badge badge-<%= t.prioritas %>"><%= t.prioritas.charAt(0).toUpperCase() + t.prioritas.slice(1) %></span></td>
            <td><%= formatTanggal(t.tgl_deadline) %></td>
            <td><span class="badge badge-<%= t.status_task %>"><%= t.status_task.charAt(0).toUpperCase() + t.status_task.slice(1) %></span></td>
            <td><% if (t.nama_pic) { %><%= t.nama_pic %><% } else { %><span class="muted">Belum ditentukan</span><% } %></td>
            <td class="aksi">
              <a href="<%= base %>/<%= t.id %>/edit" class="btn btn-sm">Edit</a>
              <form method="POST" action="<%= base %>/<%= t.id %>/delete" onsubmit="return confirm('Hapus tugas ini?')">
                <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../../partials/footer') %>
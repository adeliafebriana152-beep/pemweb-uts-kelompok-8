<%- include('../../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <h2 class="mb-3">Edit Data Panitia</h2>
            
            <form action="/panitia/edit/<%= pan.id %>" method="POST">
                <div class="mb-3">
                    <label class="form-label">Nama Lengkap</label>
                    <input type="text" name="nama" class="form-control" value="<%= pan.nama %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">NIM</label>
                    <input type="text" name="nim" class="form-control" value="<%= pan.nim %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Divisi</label>
                    <input type="text" name="divisi" class="form-control" value="<%= pan.divisi %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Jabatan</label>
                    <input type="text" name="jabatan" class="form-control" value="<%= pan.jabatan %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Kategori (Gender)</label>
                    <select name="jenis_kelamin" class="form-select" required>
                        <option value="Cowok" <%= pan.jenis_kelamin === 'Cowok' ? 'selected' : '' %>>Cowok</option>
                        <option value="Cewek" <%= pan.jenis_kelamin === 'Cewek' ? 'selected' : '' %>>Cewek</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">ID Event</label>
                    <input type="number" name="event_id" class="form-control" value="<%= pan.event_id %>">
                </div>
                <div class="d-flex justify-content-between">
                    <a href="/panitia" class="btn btn-secondary">Kembali</a>
                    <button type="submit" class="btn btn-primary">Update Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../../partials/footer') %>
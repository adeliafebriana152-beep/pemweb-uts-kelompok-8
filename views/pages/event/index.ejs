
<%- include('../../partials/header') %>

<div class="top-bar">
    <h1>Daftar Event</h1>
    <a href="/event/create" class="btn btn-primary">
        + Tambah Event
    </a>
</div>

<% if (msg === 'created') { %>
    <div class="alert success">Event berhasil ditambahkan.</div>
<% } %>

<% if (msg === 'updated') { %>
    <div class="alert success">Event berhasil diperbarui.</div>
<% } %>

<% if (msg === 'deleted') { %>
    <div class="alert success">Event berhasil dihapus.</div>
<% } %>


<!-- FILTER EVENT -->
<form method="GET" action="/event" class="filter">

    <input
        type="text"
        name="q"
        placeholder="Cari judul event..."
        value="<%= q %>"
    >

    <select name="status">
        <option value="">Semua Status</option>

        <option value="dibuka" <%= status === 'dibuka' ? 'selected' : '' %>>
            Dibuka
        </option>

        <option value="ditutup" <%= status === 'ditutup' ? 'selected' : '' %>>
            Ditutup
        </option>

        <option value="selesai" <%= status === 'selesai' ? 'selected' : '' %>>
            Selesai
        </option>
    </select>

    <button type="submit" class="btn">Cari</button>
    <a href="/event" class="btn">Reset</a>

</form>


<!-- DAFTAR EVENT -->
<% if (events.length === 0) { %>

    <div class="empty">Belum ada event</div>

<% } else { %>

    <div class="table-wrap">

        <table>

            <thead>
                <tr>
                    <th>No</th>
                    <th>Judul</th>
                    <th>Kategori</th>
                    <th>Tanggal</th>
                    <th>Waktu</th>
                    <th>Lokasi</th>
                    <th>Kuota</th>
                    <th>Jumlah Peserta</th>
                    <th>Panitia</th>
                    <th>Tugas</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>

            <tbody>

                <% events.forEach((e, i) => { %>

                    <tr>

                        <td data-label="No">
                            <%= i + 1 %>
                        </td>

                        <td data-label="Judul">
                            <%= e.judul %>
                        </td>

                        <td data-label="Kategori">
                            <%= e.kategori %>
                        </td>

                        <td data-label="Tanggal">
                            <%= formatTanggal(e.tanggal) %>
                        </td>

                        <td data-label="Waktu">
                            <%= formatWaktu(e.waktu) %>
                        </td>

                        <td data-label="Lokasi">
                            <%= e.lokasi %>
                        </td>

                        <td data-label="Kuota">
                            <%= e.kuota %>
                        </td>

                        <td data-label="Jumlah Peserta">
                            <a href="/event/<%= e.id %>/peserta">
                                <%= e.jumlah_peserta %>
                            </a>
                        </td>

                        <td data-label="Panitia">
                            <a href="/event/<%= e.id %>/panitia">
                                <%= e.jumlah_panitia %>
                            </a>
                        </td>

                        <td data-label="Tugas">
                            <a href="/event/<%= e.id %>/task">
                                <%= e.jumlah_tugas %>
                            </a>
                        </td>

                        <td data-label="Status">
                            <span class="badge badge-<%= e.status %>">
                                <%= e.status.charAt(0).toUpperCase() + e.status.slice(1) %>
                            </span>
                        </td>

                        <td data-label="Aksi">

                            <div class="aksi">

                                <a href="/event/<%= e.id %>/peserta" class="btn btn-sm">
                                    Peserta
                                </a>

                                <a href="/event/<%= e.id %>/panitia" class="btn btn-sm">
                                    Panitia
                                </a>

                                <a href="/event/<%= e.id %>/task" class="btn btn-sm">
                                    Tugas
                                </a>

                                <a href="/event/<%= e.id %>/edit" id="btn-edit" class="btn btn-sm">
                                    Edit
                                </a>

                                <form
                                    method="POST"
                                    action="/event/<%= e.id %>/delete"
                                    onsubmit="return confirm('Hapus event ini? Peserta, panitia, dan tugasnya akan kehilangan event (event_id menjadi NULL).')"
                                >
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Hapus
                                    </button>
                                </form>

                            </div>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

<% } %>

<%- include('../../partials/footer') %>

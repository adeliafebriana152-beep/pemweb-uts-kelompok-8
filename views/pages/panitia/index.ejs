<%- include('../../partials/header') %>
<%- include('../../partials/nav', { active: 'panitia' }) %>

<div class="top-bar">
  <h1>Panitia</h1>
  <a href="<%= base %>/create" class="btn btn-primary">+ Tambah Panitia</a>
</div>

<% if (msg === 'created') { %><div class="alert success">Panitia berhasil ditambahkan.</div><% } %>
<% if (msg === 'updated') { %><div class="alert success">Panitia berhasil diperbarui.</div><% } %>
<% if (msg === 'deleted') { %><div class="alert success">Panitia berhasil dihapus.</div><% } %>

<form method="GET" action="<%= base %>" class="filter">
  <input type="text" name="q" placeholder="Cari nama atau NIM..." value="<%= q %>">
  <button type="submit" class="btn">Cari</button>
  <a href="<%= base %>" class="btn">Reset</a>
</form>

<% if (panitia.length === 0) { %>
  <div class="empty">Belum ada panitia</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>No</th><th>Nama</th><th>NIM</th><th>Divisi</th><th>Jabatan</th><th>Jenis Kelamin</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% panitia.forEach((p, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= p.nama %></td>
            <td><%= p.nim %></td>
            <td><%= p.divisi %></td>
            <td><%= p.jabatan %></td>
            <td><%= p.jenis_kelamin %></td>
            <td class="aksi">
              <a href="<%= base %>/<%= p.id %>/edit" class="btn btn-sm">Edit</a>
              <form method="POST" action="<%= base %>/<%= p.id %>/delete" onsubmit="return confirm('Hapus panitia ini?')">
                <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../../partials/footer') %>
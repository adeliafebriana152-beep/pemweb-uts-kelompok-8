<%- include('../../partials/header', { pageTitle: pageTitle }) %>
<section class="form-card">
    <h2>Daftar Tugas : <%= event.judul %> </h2>
    <a href="/event/<%= event.id %>/task/tambah">+ Tambah Tugas</a>

    <form method="GET" action="/event/<%= event.id %>/task" class="filter-form">
        <label for="divisi">Divisi</label>
        <select name="divisi" id="divisi">
            <option value="">Semua divisi</option>
            <% divisiList.forEach(d => { %>
            <option value="<%= d %>" <%= divisiAktif === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
        </select>

        <label for="status">Status</label>
        <select name="status" id="status">
            <option value="">Semua status</option>
            <% statusList.forEach(s => { %>
            <option value="<%= s %>" <%= statusAktif === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
        </select>

        <button type="submit">Terapkan</button>
        <a href="/event/<%= event.id %>/task">Reset</a>
    </form>

  <% if (listTask.length === 0) { %>
    <p class="kosong">Tugas untuk divisi ini tidak tersedia.</p>
  <% } %>

  <div class="list-tugas">
    <table>
        <thead>
            <tr>
                <th>Nama Tugas</th>
                <th>Prioritas</th>
                <th>Tanggal Deadline</th>
                <th>Status Tugas</th>
                <th>PIC</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% listTasks.forEach(task => { %>
            <tr>
                <td><%= task.nama_task %></td>
                <td><%= task.prioritas %></td>
                <td><%= task.tgl_deadline %></td>
                <td><%= task.status_task %></td>
                <td><%= task.pic %></td>
                <td>
                    <a href="/event/<%= event.id %>/task/edit/<%= task.id %>">Edit</a>
                    <form method="POST" action="/event/<%= event.id %>/task/hapus/<%= task.id %>" style="display:inline"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus tugas ini?')">
                    <button type="submit" class="tombol-hapus">Hapus</button>
                    </form>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>
  </div>
</section>

<%- include('../../partials/footer') %>